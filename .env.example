# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit .env)
NODE_ENV=development
PORT=4000

# MongoDB แบบ standalone ใช้ได้ ไม่ต้องเป็น replica set (ไม่ใช้ transaction)
# ใช้กับ docker compose: compose จะ override ค่านี้ให้เอง (mongodb://mongo:27017/...)
MONGODB_URI=mongodb://localhost:27017/running_event
# สุ่มอย่างน้อย 32 ตัวอักษร:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# ว่าง = true เมื่อ NODE_ENV=production (ถ้าใช้ http ล้วน ๆ ให้ตั้ง false)
COOKIE_SECURE=

# origin ของหน้าบ้าน/หลังบ้าน คั่นด้วย comma (ใช้กับ CORS + ตรวจ Origin ของ request ที่แก้ไขข้อมูล)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# base64 ของ 32 bytes สำหรับเข้ารหัสเลขบัตรประชาชน (AES-256-GCM):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# เปลี่ยนค่านี้ภายหลังไม่ได้ ข้อมูลเดิมจะถอดรหัสไม่ได้
ID_ENCRYPTION_KEY=

UPLOAD_DIR=./uploads
MAX_SLIP_MB=5
# Event images: upload writes per minute per admin user / public image reads per minute per IP
UPLOAD_RATE_MAX=20
IMAGE_RATE_MAX=600
# ออเดอร์ pending หมดอายุภายในกี่ชั่วโมง
ORDER_EXPIRE_HOURS=24
SHIPPING_FEE=50
BCRYPT_COST=12

# จำนวน reverse proxy ที่อยู่หน้า API (0 = ไม่มี, 1 = caddy) ใช้ให้ rate limit เห็น IP จริง
TRUST_PROXY=0

# โดเมนสำหรับ caddy (docker compose --profile proxy)
API_DOMAIN=api.example.com

# --- seed ---
# SEED_ADMIN_* ใช้โดย seed-admin (CI/CD รันหลัง deploy: สร้างเฉพาะ super admin คนแรก ข้ามถ้ามีอยู่แล้ว
# หรือมี super admin ที่ active อยู่แล้ว หรือไม่ได้ตั้งค่า) และใช้โดย npm run seed:admin ด้วย
# รหัสผ่านอย่างน้อย 10 ตัวอักษร ตั้งเอง ห้ามใช้ค่าตัวอย่าง; หลัง login ครั้งแรกควรเปลี่ยนรหัสผ่านและลบ SEED_ADMIN_PASSWORD ออก
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin
